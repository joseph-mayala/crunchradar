{
  "name": "crunchradar-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5199 --strictPort",
    "dev:mock": "VITE_MOCK=1 vite --port 5199 --strictPort",
    "build": "tsc -b && vite build",
    "build:mock": "tsc -b && VITE_MOCK=1 vite build --outDir dist-mock",
    "preview": "vite preview --port 5199 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "motion": "^14.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.0.0"
  }
}
