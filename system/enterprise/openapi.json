  "components": {
    "schemas": {
      "Body_approve_do_approve__token__post": {
        "properties": {
          "decision": {
            "type": "string",
            "title": "Decision"
          }
        },
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "Body_approve_do_approve__token__post"
      },
      "Draft": {
        "properties": {
          "mod": {
            "type": "string",
            "title": "Mod"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "default": "New assignment"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "weight": {
            "type": "number",
            "title": "Weight",
            "default": 0
          },
          "words": {
            "type": "integer",
            "title": "Words",
            "default": 0
          },
          "group": {
            "type": "boolean",
            "title": "Group",
            "default": false
          },
          "due": {
            "type": "integer",
            "title": "Due"
          },
          "brief_text": {
            "type": "string",
            "title": "Brief Text",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "mod",
          "type",
          "due"
        ],
        "title": "Draft"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Pulse": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "token": {
            "type": "string",
            "title": "Token"
          },
          "week": {
            "type": "integer",
            "title": "Week"
          }
        },
        "type": "object",
        "required": [
          "email",
          "token",
          "week"
        ],
        "title": "Pulse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}