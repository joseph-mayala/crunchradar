# Copy to .env (gitignored). Nothing here is required: with no values the system runs on rules and an outbox.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
BASE_URL=http://localhost:8000
APP_SECRET=change-me
CRON_KEY=
# Needed when the app is reachable by others: the dashboard and outbox show approval links. Open with ?key=... or an X-Admin-Key header.
ADMIN_KEY=
PL_EMAIL=programme.leader@example.edu
COHORT_SIZE=52
# Real calendar feed and briefs (default = the sample cohort in data/)
CALENDAR_ICS=
BRIEFS_DIR=
# Email. With SMTP unset, mail is stored in the outbox (GET /outbox) instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
